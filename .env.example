PORT=3000

# Option 1: Full connection string (for Supabase/Cloud hosting)
# Use port 6543 for connection pooler (recommended)
DATABASE_URL=postgres://postgres:[YOUR-PASSWORD]@db.xxxxxx.supabase.co:6543/postgres
DB_SSL=true

# Option 2: Individual parameters (for local development)
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_NAME=coaching_tracker
